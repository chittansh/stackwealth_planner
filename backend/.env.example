# LLM — required for the planner agent + LLM intake.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed for the knowledge-base RAG embeddings + audio transcription.
OPENAI_API_KEY=sk-...

# DB — leave commented out to use the built-in in-memory store (perfect for the demo).
# Set this to a real Neon / Postgres URL only when you want persistence.
# DATABASE_URL=postgres://user:pass@host:5432/stackwealth

# Override the planner model if needed. Defaults to claude-sonnet-4-6.
# PLANNER_MODEL=claude-sonnet-4-6

# server
PORT=4000
NODE_ENV=development

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Langfuse — observability / tracing for the planner agent.
# Leave blank to disable tracing (the SDK becomes a no-op).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

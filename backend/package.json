    "ai": "^4.3.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "mammoth": "^1.8.0",
    "openai": "^4.71.0",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@stackwealth/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/pdf-parse": "^1.1.4",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
